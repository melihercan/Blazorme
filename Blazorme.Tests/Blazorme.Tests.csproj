<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Blazorme.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoApp\DemoApp.csproj" />
    <ProjectReference Include="..\Diff\Diff.csproj" />
    <ProjectReference Include="..\Split\Split.csproj" />
    <ProjectReference Include="..\StreamSaver\StreamSaver.csproj" />
    <ProjectReference Include="..\TestHost\TestHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AwesomeAssertions, not FluentAssertions: FluentAssertions went commercial at 8.0
         and 7.2.2 was the last Apache-2.0 release, so a pin was all that held the line -
         and a pin only holds until someone updates everything at once. This is the fork
         of that release: Apache-2.0, same API. -->
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

</Project>
