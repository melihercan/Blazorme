<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Blazorme.Diff</PackageId>
    <AssemblyName>Blazorme.Diff</AssemblyName>
    <RootNamespace>BlazormeDiff</RootNamespace>
    <Version>26.09.07</Version>
    <Authors>melihercan</Authors>
    <Company>melihercan</Company>
    <Product>Blazorme.Diff</Product>
    <Copyright>melihercan 2020-2026</Copyright>
    <Description>Diff component library for Blazor apps.
It will render diff of the two input strings in different output display formats.
It can also be used as a library to get diff or html diff output strings from code behind.</Description>
    <PackageTags>blazor diff components</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>me.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/melihercan/Blazorme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/melihercan/Blazorme</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Modernised for .NET 10. Targets net10.0 only; netstandard2.1 and net5.0 are no longer supported.
Fixed: the component fetched its diff twice on every first render, which meant two JS round trips for the Row and Column formats.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\doc\me.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="htmldiff.net" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

</Project>
