<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Blazorme.Split</PackageId>
    <AssemblyName>Blazorme.Split</AssemblyName>
    <RootNamespace>BlazormeSplit</RootNamespace>
    <Version>26.09.08</Version>
    <Authors>melihercan</Authors>
    <Company>melihercan</Company>
    <Product>Blazorme.Split</Product>
    <Copyright>melihercan 2020-2026</Copyright>
    <Description>Split component library for Blazor apps.
It provides resizeable split views (panes).</Description>
    <PackageTags>blazor split resizable panes components</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>me.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/melihercan/Blazorme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/melihercan/Blazorme</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>The Split.js asset now ships inside the package and loads on demand, so a consuming app no longer has to add a CDN script tag to index.html. A missing tag previously caused a JS interop error at runtime. Apps that still have the tag keep working; the loader skips loading when the global is already present.
See THIRD-PARTY-NOTICES.txt for the bundled component and its licence.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\doc\me.png" Pack="true" PackagePath="" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

</Project>
