<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Blazorme.TestHost</PackageId>
    <AssemblyName>Blazorme.TestHost</AssemblyName>
    <RootNamespace>BlazormeTestHost</RootNamespace>
    <Authors>melihercan</Authors>
    <Company>melihercan</Company>
    <Product>Blazorme.TestHost</Product>
    <Copyright>melihercan 2020-2026</Copyright>
    <Description>Helpers for unit testing Blazor components, packaged from Steve Sanderson's BlazorUnitTestingPrototype, which he published as source only:
https://blog.stevensanderson.com/2019/08/29/blazor-unit-testing-prototype/
https://github.com/SteveSandersonMS/BlazorUnitTestingPrototype
Note that bUnit grew out of the same prototype and is the actively maintained option; prefer it for new test suites.</Description>
    <PackageTags>blazor testing TestHost</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>me.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/melihercan/Blazorme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/melihercan/Blazorme</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>.NET 10 only. The .NET 8 target has been dropped: ASP.NET Core 10.0.x ships no net8.0 assets, so supporting both meant pinning .NET 8 projects to ASP.NET Core 8 indefinitely, and .NET 8 leaves support in November 2026. Projects still on .NET 8 should stay on 26.9.7, which remains available and carries a net8.0 build.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\doc\me.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- One entry per package and no conditional groups, now that there is one target framework.
       The rule those groups existed to enforce still holds and is worth keeping in mind if a
       second framework is ever added back: declare a framework package once, never alongside an
       unconditional entry for the same id. That combination is what broke 1.0.0 - duplicate
       PackageReference items do not merge, the first wins, and the conditional one is silently
       discarded (NU1504), so every build was bound to ASP.NET Core 3.1. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
    <PackageReference Include="RichardSzalay.MockHttp" Version="6.0.0" />
  </ItemGroup>

</Project>
